# Copy to .env and fill values locally. Never commit .env.
PORT=4174
HOST=127.0.0.1
APP_ORIGIN=http://localhost:4174
DATA_DIR=data
# Hosted deployments require Postgres and a stable encryption key.
# Leave both blank locally to continue using the existing SQLite database.
DATABASE_URL=
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Store privately; never rotate without migrating encrypted GitHub tokens.
TOKEN_ENCRYPTION_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Exact model ID from NVIDIA's API example for your selected model.
NVIDIA_MODEL=
NVIDIA_API_KEY=
# GitHub App: Contents read-only, Metadata read-only, user authorization.
# Callback URL: http://localhost:4174/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
