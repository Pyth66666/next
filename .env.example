# Copy to .env and fill values locally. Never commit .env.
PORT=4174
HOST=127.0.0.1
APP_ORIGIN=http://localhost:4174
DATA_DIR=data
# Hosted deployments require Postgres and a stable encryption key.
# Leave both blank locally to continue using the existing SQLite database.
DATABASE_URL=
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Store privately; never rotate without migrating encrypted GitHub tokens.
TOKEN_ENCRYPTION_KEY=
# Gemini is the default provider. Copy your key from Google AI Studio.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# OpenAI-compatible provider: set AI_PROVIDER=nvidia to use these instead.
# Works with NVIDIA or any /chat/completions gateway, e.g. Rapidscreen:
#   NVIDIA_BASE_URL=https://litellm.rapidscreen.io/v1  NVIDIA_MODEL=deepseek-v4-flash
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
NVIDIA_API_KEY=
# GitHub App: Contents read-only, Metadata read-only, user authorization.
# Callback URL: http://localhost:4174/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The same GitHub App also powers "Continue with GitHub". Add this second callback URL
# to the app and give it the "Email addresses: read-only" account permission:
#   http://localhost:4174/api/auth/github/callback

# "Continue with Google": create an OAuth client (Web application) in Google Cloud Console.
# Authorized redirect URI: http://localhost:4174/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admins can open Account → See users' progress. Comma-separated emails.
ADMIN_EMAILS=

# Password reset emails are sent through Resend (free plan available at resend.com).
# EMAIL_FROM must use a domain you verified in Resend, e.g. Apexelerate <hello@yourdomain.com>.
# Leave blank to switch off "Forgot your password?" (the page says so plainly).
RESEND_API_KEY=

# Optional: lets the idea checker search Product Hunt launches.
# Create a developer token at https://www.producthunt.com/v2/oauth/applications
PRODUCT_HUNT_TOKEN=
EMAIL_FROM=

# Comma-separated existing account UUIDs. Never emails or passwords.
ADMIN_USER_IDS=
